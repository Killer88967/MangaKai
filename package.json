{
  "name": "MangaKai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter mobile run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "banner": "pnpm --filter @mangakai/cli run cli",
    "picks": "pnpm --filter @mangakai/cli run picks"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18"
  }
}
