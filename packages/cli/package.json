{
  "name": "@mangakai/cli",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "mangakai": "./src/index.ts"
  },
  "scripts": {
    "cli": "tsx --env-file-if-exists=../../apps/api/.env src/index.ts",
    "check-types": "tsc --noEmit",
    "picks": "tsx --env-file-if-exists=../../apps/api/.env src/picks.ts",
    "ports": "tsx src/ports.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@mangakai/shared": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
